name: Build ZOLTA APK + AAB
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -o zolta.zip && rm zolta.zip
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - run: npm install
      - run: npm run build || npx vite build
      - run: npm install @capacitor/core @capacitor/cli @capacitor/android
      - run: npx cap add android || true
      - run: npx cap copy android
      - run: cd android && chmod +x gradlew &&./gradlew bundleRelease
      - run: cd android &&./gradlew assembleRelease
      - uses: actions/upload-artifact@v4
        with:
          name: ZOLTA-AAB-for-PlayStore
          path: android/app/build/outputs/bundle/release/*.aab
      - uses: actions/upload-artifact@v4
        with:
          name: ZOLTA-APK-for-Phone
          path: android/app/build/outputs/apk/release/*.apk
